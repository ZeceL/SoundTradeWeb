@model SoundTradeWebApp.Models.ViewModels.CatalogViewModel
@{
    ViewData["Title"] = "Каталог";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="catalog-page-content">

    <button id="toggleContent">Переключить на тексты песен</button>

    @* --- Контейнер для поиска и фильтров --- *@
    <div class="filter-controls">
        @* Стили для этого класса будут в @section Styles *@

        @* --- Форма Поиска (с классом search-form) --- *@
        <form method="get" asp-controller="Catalog" asp-action="Index" class="search-form">
            <label asp-for="SearchString" class="visually-hidden">Поиск</label>
            @* Поле ввода с классом search-input *@
            <input type="text" asp-for="SearchString" placeholder="Поиск по названию или автору..." class="form-control search-input" />
            <button type="submit" class="btn btn-search" style="margin-left: 10px; background-color: #007BFF;">Поиск</button>
        </form>

        @* --- Форма Фильтров (с классом filter-form) --- *@
        <form method="get" asp-controller="Catalog" asp-action="Index" class="filter-form">
            <input type="hidden" name="SearchString" value="@Model.SearchString" /> @* Сохраняем поиск *@

            <div>
                @* Обертки для каждого select + label (если бы он был видимым) *@
                <label asp-for="SelectedGenre" class="visually-hidden"></label>
                <select asp-for="SelectedGenre" asp-items="@Model.AvailableGenres" class="form-control filter-select"></select>
            </div>
            <div>
                <label asp-for="SelectedVocalType" class="visually-hidden"></label>
                <select asp-for="SelectedVocalType" asp-items="@Model.AvailableVocalTypes" class="form-control filter-select"></select>
            </div>
            <div>
                <label asp-for="SelectedMood" class="visually-hidden"></label>
                <select asp-for="SelectedMood" asp-items="@Model.AvailableMoods" class="form-control filter-select"></select>
            </div>
            <div>
                <button type="submit" class="btn btn-filter" style="margin-left: 10px; background-color: #007BFF;">Применить фильтры</button>
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-secondary" style="margin-left: 10px; background-color: #DC3545; border-color: #6c757d; color:white;">Сбросить все</a>
            </div>
        </form>
    </div>
    @* --- Список Песен --- *@
    <div class="song-section">
        @if (!Model.Tracks.Any()) @* <--- Используем Model.Tracks *@
        {
            <p style="color: #ccc;">Треки, соответствующие фильтрам, не найдены.</p>
        }
        else
        {
            <div class="song-list-detailed">
            @foreach (var track in Model.Tracks) @* <--- Используем Model.Tracks *@
            {
                <div class="song-item" data-track-id="@track.Id">
                    <h3>@Html.DisplayFor(modelItem => track.Title)</h3>
                    <p>@Html.DisplayFor(modelItem => track.ArtistName)</p>
                    <p style="font-size: 0.9em; color: #aaa;">
                        @if (!string.IsNullOrEmpty(track.Genre))
                        {
                            <span style="margin-right: 10px;">Жанр: @track.Genre</span>
                        }
                        @if (!string.IsNullOrEmpty(track.VocalType))
                        {
                            <span>Вокал: @track.VocalType</span>
                        }
                        @* TODO: Отобразить Mood, если нужно *@
                    </p>
                    <div class="song-item-actions">
                        @* Используем track.AudioFilePath, который теперь содержит URL к действию *@
                        <button class="play-song-btn" data-song-url="@track.AudioFilePath">Слушать</button>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var currentUserIdString = User.FindFirstValue(ClaimTypes.NameIdentifier);
                            int.TryParse(currentUserIdString, out int currentUserId);

                            @if (track.AuthorUserId != currentUserId) // Не показывать кнопку для своих треков
                            {
                                <a asp-controller="Exchange" asp-action="InitiateOffer" asp-route-requestedTrackId="@track.Id"
                                   class="btn-action offer-btn">
                                    Предложить обмен
                                </a>

                                <a asp-controller="Purchase" asp-action="Confirm" asp-route-trackId="@track.Id"
                                   class="btn-action buy-btn">
                                    Купить
                                </a>
                            }
                        }
                    </div>
                </div>
            }
            </div>
        }
    </div>

    @* --- Список Текстов (скрыт по умолчанию) --- *@
    <div class="lyrics-list" style="display: none;">
        @if (!Model.Tracks.Any(t => !string.IsNullOrEmpty(t.Lyrics)))
        {
            <p style="color: #ccc;">Тексты песен отсутствуют.</p>
        }
        else
        {
            @foreach (var track in Model.Tracks.Where(t => !string.IsNullOrEmpty(t.Lyrics)))
            {
                <div class="lyrics-item" data-track-id="@track.Id">
                    @* Добавим ID трека и сюда *@
                    <div style="display: flex; align-items: center; justify-content: center; margin-bottom: 10px; flex-wrap: wrap;">
                        @* Обертка для заголовка и кнопки *@
                        <h2 style="margin: 0 15px 0 0; color: #eee;">@Html.DisplayFor(modelItem => track.Title) (@Html.DisplayFor(modelItem => track.ArtistName))</h2>
                        @* --- Новая Кнопка "Слушать" --- *@
                        <button class="play-song-btn"
                                data-song-url="@track.AudioFilePath"
                                data-title="@track.Title" @* Передаем название в data-атрибуте *@ 
                                data-artist="@track.ArtistName" @* Передаем исполнителя в data-атрибуте *@ 
                                style="padding: 5px 10px; font-size: 0.9em; background-color: #4CAF50; color: white; border: none; border-radius: 4px; cursor: pointer; line-height: 1;">
                            Слушать
                        </button>
                    </div>
                    <pre style="white-space: pre-wrap; color: #bbb; text-align: left; max-height: 400px; overflow-y: auto; background-color: rgba(0,0,0,0.1); padding: 10px; border-radius: 4px;">@Html.DisplayFor(modelItem => track.Lyrics)</pre>
                </div>
            }
        }
    </div>
</div>

@* --- Секция Стилей --- *@
@section Styles {
    <style>
        
        /* --- Стиль для контейнера треков (CSS Grid) --- */
        .song-list-detailed {
            display: grid; /* Используем Grid Layout */
            grid-template-columns: repeat(2, 1fr); /* Создаем 2 колонки равной ширины (1fr) */
            gap: 35px; /* Пространство между колонками и рядами */
            margin-top: 15px;
            padding-right: 10px;
        }

            /* Стили для .song-item внутри грида */
            .song-list-detailed .song-item {
                background: #222;
                color: #ccc;
                padding: 15px;
                border-radius: 8px;
                text-align: center;
                box-shadow: 0 2px 5px rgba(0,0,0,0.2);
                box-sizing: border-box;
                transition: transform 0.2s ease;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
            }

                .song-list-detailed .song-item:hover {
                    transform: translateY(-3px);
                }

                /* Контейнер для кнопок */
                .song-list-detailed .song-item .song-item-actions {
                    margin-top: 15px; /* Отступ сверху для кнопок */
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    gap: 10px; /* Расстояние между кнопками */
                    flex-wrap: wrap;
                }

                /* Общие стили для кнопок и ссылок-кнопок на главной */
                .song-list-detailed .song-item button,
                .song-list-detailed .song-item .btn-action {
                    padding: 8px 15px;
                    border: none;
                    border-radius: 5px;
                    cursor: pointer;
                    font-size: 0.9em;
                    font-weight: bold;
                    color: white;
                    text-decoration: none;
                    transition: filter 0.2s, transform 0.2s;
                }

                .song-list-detailed .song-item .play-song-btn {
                    background-color: #4CAF50;
                }
                /* Зеленый */
                .song-list-detailed .song-item .offer-btn {
                    background-color: #007BFF;
                }
                /* Синий */
                .song-list-detailed .song-item .buy-btn {
                    background-color: #6f42c1;
                }
                /* Фиолетовый */

                .song-list-detailed .song-item button:hover,
                .song-list-detailed .song-item .btn-action:hover {
                    filter: brightness(1.15);
                    transform: scale(1.05);
                }

        @@media (max-width: 768px) {
            .catalog-page-content .song-list {
                grid-template-columns: 1fr;
                gap: 10px;
            }
        }
        /* Убедимся, что на более крупных экранах (до 992px) нет лишних отступов, если они не нужны */
        @@media (min-width: 769px) and (max-width: 992px) {
            .catalog-page-content .song-list {
                max-width: 100%;
                margin-left: 0;
                margin-right: 0;
            }
        }


        /* --- НОВЫЕ СТИЛИ ДЛЯ ФИЛЬТРОВ И ПОИСКА (в одну строку) --- */
        .filter-controls {
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            align-items: center;
            gap: 15px;
            background-color: #252525;
            padding: 10px 15px; /* Уменьшили вертикальный padding */
            border-radius: 8px;
            margin-bottom: 30px;
        }

            /* Форма поиска */
            .filter-controls .search-form {
                display: flex;
                align-items: center;
                gap: 8px; /* Небольшой отступ между полем и кнопкой поиска */
            }
            /* Поле поиска */
            .filter-controls .search-input {
                width: 300px; /* <<-- УМЕНЬШЕННЫЙ РАЗМЕР ПОЛЯ ПОИСКА (подберите) */
            }

            /* Форма фильтров */
            .filter-controls .filter-form {
                display: flex;
                align-items: center;
                flex-wrap: wrap; /* Разрешаем перенос фильтров */
                gap: 8px;
                flex-grow: 1;
                justify-content: flex-start;
            }
                /* Обертка для каждого select/button внутри формы фильтров */
                .filter-controls .filter-form div {
                    margin-bottom: 0; /* Убираем лишние отступы, если были */
                }

                .filter-controls .filter-form select.form-control {
                    min-width: 130px; /* Минимальная ширина для select */
                }

            /* Общие стили для полей ввода и выпадающих списков в этом блоке */
            .filter-controls .form-control {
                padding: 6px 10px;
                border-radius: 4px;
                border: 1px solid #555;
                background: #333;
                color: white;
                font-size: 0.9em; /* Уменьшили шрифт */
                height: 34px;
                box-sizing: border-box;
                line-height: normal;
            }

                .filter-controls .form-control:focus {
                    border-color: #4CAF50;
                    box-shadow: 0 0 0 0.15rem rgba(76, 175, 80, 0.25); /* Уменьшили тень */
                    outline: none;
                }

            /* Стили для кнопок в этом блоке */
            .filter-controls .btn {
                padding: 6px 12px;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                font-size: 0.9em; /* Уменьшили шрифт */
                height: 34px;
                transition: background-color 0.2s, transform 0.1s;
                white-space: nowrap;
                color: white;
            }

            .filter-controls .btn-search {
                background: #0d6efd;
            }

            .filter-controls .btn-filter {
                background: linear-gradient(45deg, #ff416c, #ff4b2b);
            }

            .filter-controls .btn:hover {
                filter: brightness(1.1);
                transform: scale(1.02);
            }

            .filter-controls .btn:active {
                transform: scale(0.98);
            }

        .visually-hidden {
            position: absolute;
            width: 1px;
            height: 1px;
            margin: -1px;
            padding: 0;
            overflow: hidden;
            clip: rect(0,0,0,0);
            border: 0;
        }

        /* Адаптивность для фильтров и поиска */
        @@media (max-width: 768px) {
            .filter-controls {
                flex-direction: column;
                align-items: stretch;
                gap: 15px;
            }

                .filter-controls .search-form {
                    margin-right: 0;
                    width: 100%;
                }

                .filter-controls .search-input {
                    flex-grow: 1;
                    width: auto;
                }

                .filter-controls .filter-form {
                    width: 100%;
                }

                    .filter-controls .filter-form div {
                        flex-grow: 1;
                        min-width: 120px;
                    }

                        .filter-controls .filter-form div:last-child { /* Кнопка фильтров */
                            flex-grow: 0;
                        }
        }

        /* Стили для lyrics-list (для отображения в одну колонку) */
        .catalog-page-content .lyrics-list {
            display: none;
            flex-direction: column;
            align-items: center;
            gap: 20px;
            margin-top: 20px;
        }
        /* Стили для элемента текста (остаются) */
        .lyrics-item {
            background: #222;
            color: #ccc;
            padding: 20px;
            width: 80%;
            max-width: 700px; /* Ограничиваем ширину */
            border-radius: 10px;
            text-align: center;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.3);
        }

            .lyrics-item h2 {
                color: #eee;
                margin-bottom: 10px;
            }

            .lyrics-item .play-song-btn { /* Стили для кнопки "Слушать" у текста */
                padding: 5px 10px;
                font-size: 0.85em;
                background-color: #4CAF50;
                color: white;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                line-height: 1;
                vertical-align: middle;
                margin-left: 10px;
            }

                .lyrics-item .play-song-btn:hover {
                    filter: brightness(1.1);
                }

            .lyrics-item pre {
                white-space: pre-wrap;
                color: #bbb;
                text-align: left;
                max-height: 400px;
                overflow-y: auto;
                background-color: rgba(0,0,0,0.1);
                padding: 10px;
                border-radius: 4px;
            }

    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 1. Находим все необходимые элементы управления
            const toggleButton = document.getElementById('toggleContent');
            const songSection = document.querySelector('.song-section'); // Правильный селектор для контейнера песен
            const lyricsList = document.querySelector('.lyrics-list');
            const filterControls = document.querySelector('.filter-controls');

            // 2. Проверяем, что все элементы найдены, иначе выходим
            if (!toggleButton || !songSection || !lyricsList || !filterControls) {
                console.error('Ошибка: Не удалось найти один или несколько элементов для управления видом каталога.');
                return;
            }

            // 3. Добавляем обработчик клика на кнопку
            toggleButton.addEventListener('click', function () {
                // Определяем, видимы ли в данный момент тексты песен
                const isLyricsVisible = lyricsList.style.display !== 'none';

                if (isLyricsVisible) {
                    // ЕСЛИ ВИДНЫ ТЕКСТЫ -> ПЕРЕКЛЮЧАЕМ НА ПЕСНИ

                    // Скрываем тексты
                    lyricsList.style.display = 'none';

                    // Показываем блок с песнями и блок с фильтрами
                    // Используем 'block' - это стандартное отображение для <div>,
                    // которое не будет конфликтовать со стилями дочерних элементов.
                    songSection.style.display = 'block';
                    filterControls.style.display = 'flex';

                    // Меняем текст на кнопке
                    toggleButton.textContent = 'Переключить на тексты песен';
                } else {
                    // ЕСЛИ ВИДНЫ ПЕСНИ -> ПЕРЕКЛЮЧАЕМ НА ТЕКСТЫ

                    // Скрываем блок с песнями и фильтры
                    songSection.style.display = 'none';
                    filterControls.style.display = 'none';

                    // Показываем тексты. Используем 'flex', так как в ваших стилях
                    // для .lyrics-list указан 'display: flex'
                    lyricsList.style.display = 'flex';

                    // Меняем текст на кнопке
                    toggleButton.textContent = 'Переключить на список песен';
                }
            });
        });
    </script>
}
@model SoundTradeWebApp.Models.ViewModels.CatalogViewModel
@{
    ViewData["Title"] = "Каталог";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="catalog-page-content">

    <button id="toggleContent">Переключить на тексты песен</button>

    @* --- Контейнер для поиска и фильтров --- *@
    <div class="filter-controls">
        @* Стили для этого класса будут в @section Styles *@

        @* --- Форма Поиска (с классом search-form) --- *@
        <form method="get" asp-controller="Catalog" asp-action="Index" class="search-form">
            <label asp-for="SearchString" class="visually-hidden">Поиск</label>
            @* Поле ввода с классом search-input *@
            <input type="text" asp-for="SearchString" placeholder="Поиск по названию или автору..." class="form-control search-input" />
            <button type="submit" class="btn btn-search">Поиск</button>
        </form>

        @* --- Форма Фильтров (с классом filter-form) --- *@
        <form method="get" asp-controller="Catalog" asp-action="Index" class="filter-form">
            <input type="hidden" name="SearchString" value="@Model.SearchString" /> @* Сохраняем поиск *@

            <div>
                @* Обертки для каждого select + label (если бы он был видимым) *@
                <label asp-for="SelectedGenre" class="visually-hidden"></label>
                <select asp-for="SelectedGenre" asp-items="@Model.AvailableGenres" class="form-control filter-select"></select>
            </div>
            <div>
                <label asp-for="SelectedVocalType" class="visually-hidden"></label>
                <select asp-for="SelectedVocalType" asp-items="@Model.AvailableVocalTypes" class="form-control filter-select"></select>
            </div>
            <div>
                <label asp-for="SelectedMood" class="visually-hidden"></label>
                <select asp-for="SelectedMood" asp-items="@Model.AvailableMoods" class="form-control filter-select"></select>
            </div>
            <div>
                <button type="submit" class="btn btn-filter">Применить фильтры</button>
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-secondary" style="margin-left: 10px; background-color: #6c757d; border-color: #6c757d; color:white;">Сбросить все</a>
            </div>
        </form>
    </div>
    @* --- Список Песен --- *@
    <div class="song-list">
        @if (!Model.Tracks.Any()) @* <--- Используем Model.Tracks *@
        {
            <p style="color: #ccc;">Треки, соответствующие фильтрам, не найдены.</p>
        }
        else
        {
            @foreach (var track in Model.Tracks) @* <--- Используем Model.Tracks *@
            {
                <div class="song-item" data-track-id="@track.Id">
                    <h3>@Html.DisplayFor(modelItem => track.Title)</h3>
                    <p>@Html.DisplayFor(modelItem => track.ArtistName)</p>
                     <p style="font-size: 0.9em; color: #aaa;">
                        @if (!string.IsNullOrEmpty(track.Genre)) { <span style="margin-right: 10px;">Жанр: @track.Genre</span> }
                        @if (!string.IsNullOrEmpty(track.VocalType)) { <span>Вокал: @track.VocalType</span> }
                        @* TODO: Отобразить Mood, если нужно *@
                    </p>
                     @* Используем track.AudioFilePath, который теперь содержит URL к действию *@
                     <button class="play-song-btn" data-song-url="@track.AudioFilePath">Слушать</button>
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        var currentUserIdString = User.FindFirstValue(ClaimTypes.NameIdentifier);
                        int.TryParse(currentUserIdString, out int currentUserId);

                        @if (track.AuthorUserId != currentUserId) // Не показывать кнопку для своих треков
                        {
                            <a asp-controller="Exchange" asp-action="InitiateOffer" asp-route-requestedTrackId="@track.Id"
                               class="btn btn-info" style="margin-top: 10px; margin-left: 5px; background-color: #17a2b8; border-color: #17a2b8;">
                                Предложить обмен
                            </a>
                        }
                    }
                     <button class="buy-btn" data-song-id="@track.Id">Купить</button>
                </div>
            }
        }
    </div>

    @* --- Список Текстов (скрыт по умолчанию) --- *@
    <div class="lyrics-list" style="display: none;">
        @if (!Model.Tracks.Any(t => !string.IsNullOrEmpty(t.Lyrics)))
        {
            <p style="color: #ccc;">Тексты песен отсутствуют.</p>
        }
        else
        {
            @foreach (var track in Model.Tracks.Where(t => !string.IsNullOrEmpty(t.Lyrics)))
            {
                <div class="lyrics-item" data-track-id="@track.Id">
                    @* Добавим ID трека и сюда *@
                    <div style="display: flex; align-items: center; justify-content: center; margin-bottom: 10px; flex-wrap: wrap;">
                        @* Обертка для заголовка и кнопки *@
                        <h2 style="margin: 0 15px 0 0; color: #eee;">@Html.DisplayFor(modelItem => track.Title) (@Html.DisplayFor(modelItem => track.ArtistName))</h2>
                        @* --- Новая Кнопка "Слушать" --- *@
                        <button class="play-song-btn"
                                data-song-url="@track.AudioFilePath"
                                data-title="@track.Title" @* Передаем название в data-атрибуте *@
                                data-artist="@track.ArtistName" @* Передаем исполнителя в data-атрибуте *@
                                style="padding: 5px 10px; font-size: 0.9em; background-color: #4CAF50; color: white; border: none; border-radius: 4px; cursor: pointer; line-height: 1;">
                            Слушать
                        </button>
                    </div>
                    <pre style="white-space: pre-wrap; color: #bbb; text-align: left; max-height: 400px; overflow-y: auto; background-color: rgba(0,0,0,0.1); padding: 10px; border-radius: 4px;">@Html.DisplayFor(modelItem => track.Lyrics)</pre>
                </div>
            }
        }
    </div>
</div>

@* --- Секция Стилей --- *@
@section Styles {
    <style>
        /* --- Стили для контейнера списка треков в каталоге (2 колонки, слева) --- */
        .catalog-page-content .song-list {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin-top: 30px;
            max-width: 100%;
            margin-left: 0;
            margin-right: 0;
        }

            .catalog-page-content .song-list .song-item { /* ... стили как в предыдущем ответе ... */
                width: 100%;
                background: #222;
                color: #ccc;
                padding: 15px;
                border-radius: 8px;
                text-align: center;
                box-shadow: 0 2px 5px rgba(0,0,0,0.2);
                box-sizing: border-box;
                margin-bottom: 0;
                transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
            }

                .catalog-page-content .song-list .song-item:hover {
                    transform: translateY(-3px);
                    box-shadow: 0px 6px 12px rgba(0,0,0,0.4);
                }

                .catalog-page-content .song-list .song-item h3 {
                    color: #eee;
                    margin-bottom: 5px;
                    font-size: 1.1em;
                }

                .catalog-page-content .song-list .song-item p {
                    color: #aaa;
                    margin-bottom: 10px;
                    font-size: 0.9em;
                }

                .catalog-page-content .song-list .song-item button.play-song-btn {
                    padding: 8px 15px;
                    background-color: #4CAF50;
                    color: white;
                    border: none;
                    border-radius: 5px;
                    cursor: pointer;
                    margin-top: 10px;
                }

                .catalog-page-content .song-list .song-item button.buy-btn {
                    padding: 8px 15px;
                    background-color: #007BFF;
                    color: white;
                    border: none;
                    border-radius: 5px;
                    cursor: pointer;
                    margin-top: 10px;
                    margin-left: 10px;
                }

                .catalog-page-content .song-list .song-item button:hover {
                    filter: brightness(1.1);
                }

        @@media (max-width: 768px) {
            .catalog-page-content .song-list {
                grid-template-columns: 1fr;
                gap: 10px;
            }
        }
        /* Убедимся, что на более крупных экранах (до 992px) нет лишних отступов, если они не нужны */
        @@media (min-width: 769px) and (max-width: 992px) {
            .catalog-page-content .song-list {
                max-width: 100%;
                margin-left: 0;
                margin-right: 0;
            }
        }


        /* --- НОВЫЕ СТИЛИ ДЛЯ ФИЛЬТРОВ И ПОИСКА (в одну строку) --- */
        .filter-controls {
            display: flex; /* Главный контейнер делаем flex */
            flex-direction: row; /* Элементы (формы) в строку */
            flex-wrap: wrap; /* Разрешаем перенос на новую строку */
            align-items: center; /* Выравнивание по центру по вертикали */
            gap: 15px; /* Отступ между формой поиска и формой фильтров */
            background-color: #252525;
            padding: 10px 15px; /* Уменьшили вертикальный padding */
            border-radius: 8px;
            margin-bottom: 30px;
        }

            /* Форма поиска */
            .filter-controls .search-form {
                display: flex;
                align-items: center;
                gap: 8px; /* Небольшой отступ между полем и кнопкой поиска */
                /* flex-grow: 0; */ /* Поиск не будет растягиваться, если фильтры справа */
                /* margin-right: 15px; /* Отступ до блока фильтров, если gap у родителя недостаточен, можно убрать если gap родителя >= 15px */
            }
            /* Поле поиска */
            .filter-controls .search-input {
                width: 300px; /* <<-- УМЕНЬШЕННЫЙ РАЗМЕР ПОЛЯ ПОИСКА (подберите) */
            }

            /* Форма фильтров */
            .filter-controls .filter-form {
                display: flex;
                align-items: center;
                flex-wrap: wrap; /* Разрешаем перенос фильтров */
                gap: 8px; /* Небольшой отступ между элементами фильтров */
                flex-grow: 1; /* Форма фильтров займет оставшееся место */
                justify-content: flex-start; /* Фильтры начинаются слева */
            }
                /* Обертка для каждого select/button внутри формы фильтров */
                .filter-controls .filter-form div {
                    /* flex-grow: 1; */ /* Убираем, чтобы select-ы не растягивались слишком сильно */
                    margin-bottom: 0; /* Убираем лишние отступы, если были */
                }

                .filter-controls .filter-form select.form-control {
                    min-width: 130px; /* Минимальная ширина для select */
                }
                /* Кнопка "Применить фильтры" */
                .filter-controls .filter-form div:last-child {
                    /* margin-left: auto; */ /* Убираем прижатие кнопки фильтров вправо, пусть идет по потоку */
                }


            /* Общие стили для полей ввода и выпадающих списков в этом блоке */
            .filter-controls .form-control {
                padding: 6px 10px; /* Уменьшили padding для компактности */
                border-radius: 4px; /* Чуть меньше скругление */
                border: 1px solid #555;
                background: #333;
                color: white;
                font-size: 0.9em; /* Уменьшили шрифт */
                height: 34px; /* Уменьшили высоту */
                box-sizing: border-box;
                line-height: normal;
            }

                .filter-controls .form-control:focus {
                    border-color: #4CAF50;
                    box-shadow: 0 0 0 0.15rem rgba(76, 175, 80, 0.25); /* Уменьшили тень */
                    outline: none;
                }

            /* Стили для кнопок в этом блоке */
            .filter-controls .btn {
                padding: 6px 12px; /* Уменьшили padding */
                border: none;
                border-radius: 4px;
                cursor: pointer;
                font-size: 0.9em; /* Уменьшили шрифт */
                height: 34px; /* Уменьшили высоту */
                transition: background-color 0.2s, transform 0.1s;
                white-space: nowrap;
                color: white;
            }

            .filter-controls .btn-search {
                background: #0d6efd;
            }

            .filter-controls .btn-filter {
                background: linear-gradient(45deg, #ff416c, #ff4b2b);
            }

            .filter-controls .btn:hover {
                filter: brightness(1.1);
                transform: scale(1.02);
            }

            .filter-controls .btn:active {
                transform: scale(0.98);
            }

        .visually-hidden {
            position: absolute;
            width: 1px;
            height: 1px;
            margin: -1px;
            padding: 0;
            overflow: hidden;
            clip: rect(0,0,0,0);
            border: 0;
        }

        /* Адаптивность для фильтров и поиска */
        @@media (max-width: 768px) {
            .filter-controls {
                flex-direction: column; /* Все формы друг под другом */
                align-items: stretch; /* Формы растягиваются по ширине */
                gap: 15px; /* Вертикальный отступ между формами */
            }

                .filter-controls .search-form {
                    margin-right: 0; /* Убираем правый отступ */
                    width: 100%;
                }

                .filter-controls .search-input {
                    flex-grow: 1; /* Поле поиска растягивается */
                    width: auto; /* Автоматическая ширина */
                }

                .filter-controls .filter-form {
                    width: 100%;
                    /* Можно добавить justify-content: space-between; если элементов много */
                }

                    .filter-controls .filter-form div {
                        flex-grow: 1; /* Фильтры могут растягиваться */
                        min-width: 120px; /* Минимальная ширина для фильтров */
                    }

                        .filter-controls .filter-form div:last-child { /* Кнопка фильтров */
                            flex-grow: 0;
                        }
        }

        /* Стили для lyrics-list (для отображения в одну колонку) */
        .catalog-page-content .lyrics-list {
            display: none; /* По умолчанию скрыт */
            flex-direction: column;
            align-items: center; /* Центрируем элементы .lyrics-item */
            gap: 20px;
            margin-top: 20px;
        }
        /* Стили для элемента текста (остаются) */
        .lyrics-item {
            background: #222;
            color: #ccc;
            padding: 20px;
            width: 80%;
            max-width: 700px; /* Ограничиваем ширину */
            border-radius: 10px;
            text-align: center;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.3);
        }

            .lyrics-item h2 {
                color: #eee;
                margin-bottom: 10px;
            }

            .lyrics-item .play-song-btn { /* Стили для кнопки "Слушать" у текста */
                padding: 5px 10px;
                font-size: 0.85em;
                background-color: #4CAF50;
                color: white;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                line-height: 1;
                vertical-align: middle;
                margin-left: 10px;
            }

                .lyrics-item .play-song-btn:hover {
                    filter: brightness(1.1);
                }

            .lyrics-item pre {
                white-space: pre-wrap;
                color: #bbb;
                text-align: left;
                max-height: 400px;
                overflow-y: auto;
                background-color: rgba(0,0,0,0.1);
                padding: 10px;
                border-radius: 4px;
            }

    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            console.log("Catalog page Scripts section loaded.");

            const toggleButton = document.getElementById('toggleContent');
            const songList = document.querySelector('.catalog-page-content .song-list');
            const lyricsList = document.querySelector('.catalog-page-content .lyrics-list');
            const filterControls = document.querySelector('.catalog-page-content .filter-controls');

            console.log("ToggleButton:", toggleButton);
            console.log("SongList:", songList);
            console.log("LyricsList:", lyricsList);
            console.log("FilterControls:", filterControls);

            if (!toggleButton || !songList || !lyricsList || !filterControls) {
                console.error('ОШИБКА: Не найдены все элементы для переключения контента каталога!');
                return;
            }

            // Устанавливаем начальное состояние для lyricsList, если оно не задано CSS
            if (lyricsList.style.display === "") { // Проверяем, если display не установлен явно
                lyricsList.style.display = 'none'; // Скрываем список текстов по умолчанию
            }


            if (toggleButton && songList && lyricsList && filterControls) {
                // Начальное состояние: если список текстов не имеет display, скрываем его
                if (lyricsList.style.display === "" && songList.style.display !== 'none') { // Условие, что песни видимы
                    lyricsList.style.display = 'none';
                } else if (songList.style.display === "" && lyricsList.style.display !== 'none') { // Условие, что тексты видимы
                    songList.style.display = 'none';
                } else if (songList.style.display === "" && lyricsList.style.display === "") { // Если оба не заданы
                    lyricsList.style.display = 'none'; // Скрываем тексты по умолчанию
                    songList.style.display = 'grid'; // Показываем песни как grid
                }


                toggleButton.addEventListener('click', function () {
                    const isLyricsListVisible = lyricsList.style.display !== 'none';

                    if (isLyricsListVisible) {
                        lyricsList.style.display = 'none';
                        songList.style.display = 'grid'; // <--- ВАЖНО: ВОССТАНАВЛИВАЕМ display: grid
                        filterControls.style.display = 'flex'; // Восстанавливаем отображение фильтров
                        toggleButton.textContent = 'Переключить на тексты песен';
                    } else {
                        lyricsList.style.display = 'flex'; // Для списка текстов можно 'flex' или 'block'
                        songList.style.display = 'none';
                        filterControls.style.display = 'none'; // Скрываем фильтры при просмотре текстов
                        toggleButton.textContent = 'Переключить на список песен';
                    }
                });
            }
            // --- Код для кнопки Купить (заглушка) ---
            const buyButtons = document.querySelectorAll('.buy-btn');
            buyButtons.forEach(button => { button.addEventListener('click', function () { alert(`Покупка трека ${this.dataset.songId} еще не реализована.`); }); });

        });
    </script>
}